# Copia este archivo como `.env.test`. Lo usan los tests e2e.
# Apunta a una base de datos DISTINTA (myout_test) para no tocar tus datos de desarrollo.
NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://myout:myout_local_password@localhost:5432/myout_test?schema=public"
JWT_SECRET=secreto-solo-para-tests-no-usar-en-ningun-otro-sitio-123456
JWT_EXPIRES_IN_SECONDS=3600
ALLOW_SIMULATED_PLAN_CHANGE=true

# Imágenes subidas durante los tests (se puede borrar cuando quieras)
STORAGE_DIR=storage-test
