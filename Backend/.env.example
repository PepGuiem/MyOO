# Copia este archivo como `.env` y ajusta los valores para tu máquina.
# Son valores LOCALES y ficticios: no pongas aquí credenciales reales.

# --- Servidor HTTP ---
NODE_ENV=development
PORT=3000
# Origen del frontend (Vite) al que se permite llamar a la API (CORS).
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL local (Docker Compose) ---
POSTGRES_USER=myout
POSTGRES_PASSWORD=myout_local_password
POSTGRES_DB=myout_dev
POSTGRES_PORT=5432

# Cadena de conexión que usa Prisma (debe coincidir con los valores de arriba).
DATABASE_URL="postgresql://myout:myout_local_password@localhost:5432/myout_dev?schema=public"

# --- Autenticación ---
# Genera un valor largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
# Duración del token de acceso, en segundos (3600 = 1 hora).
JWT_EXPIRES_IN_SECONDS=3600

# --- Archivos subidos (logos e imágenes de los detalles) ---
# Carpeta local para desarrollo (está en .gitignore). En producción se usaría
# un almacenamiento de objetos (S3, MinIO...).
STORAGE_DIR=storage

# --- Planes ---
# Permite el endpoint de cambio de plan SIMULADO (sin pagos). Solo para desarrollo.
ALLOW_SIMULATED_PLAN_CHANGE=true

# --- Login con Google / Apple y conexión con Instagram (OPCIONAL) ---
# Si faltan las variables de un proveedor, su botón no aparece.
# Ver "Login con Google, Apple e Instagram" en el README.

# Origen del frontend (a donde se vuelve tras el login), sin barra final.
FRONTEND_URL=http://localhost:5173
# URL de la API tal como la ve el NAVEGADOR (en desarrollo, a través del proxy
# de Vite). Las "redirect URI" que registras en cada proveedor son:
#   <OAUTH_PUBLIC_API_URL>/auth/oauth/google/callback
#   <OAUTH_PUBLIC_API_URL>/auth/oauth/apple/callback
#   <OAUTH_PUBLIC_API_URL>/auth/oauth/instagram/callback
OAUTH_PUBLIC_API_URL=http://localhost:5173/api

# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer > Certificates, IDs & Profiles. Apple exige HTTPS y un dominio
# real (no vale localhost): en local usa un túnel HTTPS.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Ruta al archivo .p8 de la clave (guárdalo FUERA del repositorio).
APPLE_PRIVATE_KEY_PATH=

# Meta for Developers > tu app > Instagram > API con inicio de sesión de Instagram.
# Solo cuentas profesionales (creador o empresa).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Clave para cifrar los tokens de Instagram en la base de datos (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
