{
  "name": "myout-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/i18n-check.mjs",
    "preview": "vite preview",
    "models": "node scripts/prepare-garments.mjs ../prendas_3d_glb public/models/prendas",
    "models:punto": "node scripts/prepare-garments.mjs ../prendas_punto_glb public/models/prendas/punto",
    "models:casual": "node scripts/prepare-garments.mjs ../prendas_casual_glb public/models/prendas/casual",
    "models:street": "node scripts/prepare-garments.mjs ../prendas_street_glb public/models/prendas/street",
    "models:camisetas": "node scripts/prepare-garments.mjs ../prendas_street_glb/camisetas public/models/prendas/camisetas 20000 0.25",
    "models:sudaderas": "node scripts/prepare-garments.mjs ../prendas_street_glb/sudaderas_v2/glb public/models/prendas/sudaderas 20000 --pbr=../prendas_street_glb/sudaderas_v2/glb_hi",
    "textures:sudaderas": "python scripts/prepare-textures.py ../prendas_street_glb/sudaderas_v2/glb ../prendas_street_glb/sudaderas_v2/texturas public/models/prendas/sudaderas/tex",
    "models:calzado": "node scripts/prepare-garments.mjs ../prendas_calzado_glb/coleccion/glb public/models/prendas/calzado",
    "textures:calzado": "python scripts/prepare-textures.py ../prendas_calzado_glb/coleccion/glb ../prendas_calzado_glb/coleccion/texturas public/models/prendas/calzado/tex",
    "models:camisas": "node scripts/prepare-garments.mjs ../prendas_street_glb/camisas public/models/prendas/camisas 20000 0.25",
    "models:jerseis": "node scripts/prepare-garments.mjs ../prendas_street_glb/jerseis public/models/prendas/jerseis 20000 0.25",
    "models:chaquetas": "node scripts/prepare-garments.mjs ../prendas_street_glb/chaquetas public/models/prendas/chaquetas 20000 0.25",
    "models:abrigos": "node scripts/prepare-garments.mjs ../prendas_street_glb/abrigos public/models/prendas/abrigos 20000 0.25",
    "models:tops": "node scripts/prepare-garments.mjs ../prendas_street_glb/tops public/models/prendas/tops 20000 0.25",
    "models:formal": "node scripts/prepare-garments.mjs ../prendas_street_glb/formal public/models/prendas/formal 20000 0.25",
    "models:maniqui": "node scripts/prepare-garments.mjs ../prendas_casual_glb/maniqui public/models/maniqui 30000",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor #19191b --iconBackgroundColorDark #19191b --splashBackgroundColor #19191b --splashBackgroundColorDark #19191b"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
